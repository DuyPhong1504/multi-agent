# ==========================================
# CẤU HÌNH LM STUDIO (LOCAL LLM)
# ==========================================
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct
LMSTUDIO_API_KEY=lm-studio

# ==========================================
# CẤU HÌNH OLLAMA (DỰ PHÒNG)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==========================================
# API KEYS (NẾU DÙNG CLOUD MODEL)
# ==========================================
OPENAI_API_KEY=sk-proj-xxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxx

# ==========================================
# LANGSMITH / LANGCHAIN TRACING (LOGS & DEBUG)
# ==========================================
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxx
# LANGCHAIN_PROJECT=multi-agent-app
LANGSMITH_TRACING=false

# ==========================================
# CẤU HÌNH CỨNG DỰ ÁN
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO



REQUIREMENT_API_KEY=dsadsa
REQUIREMENT_MODEL=gpt-5.6-luna
REQUIREMENT_BASE_URL=https://api.xah.io/v1
